---
import { nav, profile, site, type NavKey } from '../config/site';

interface Props {
  active?: NavKey;
}
const { active } = Astro.props;

const socials = [
  { href: `https://github.com/${profile.githubUsername}`, icon: 'ri-github-line', variant: 'github' },
  { href: profile.linkedinUrl, icon: 'ri-linkedin-box-line', variant: 'linkedin' },
  { href: `mailto:${profile.email}`, icon: 'ri-mail-line', variant: 'mail' },
  { href: `https://matrix.to/#/${profile.matrixId}`, icon: 'ri-chat-1-line', variant: 'matrix', title: 'Matrix' },
];
const overflowNav = nav.filter((item) => item.overflow);
const linkClass = (key: string) =>
  `navbar-anim-link transition-colors duration-200 ${key === active ? 'text-gray-100 font-bold' : 'text-gray-400 hover:text-gray-100'}`;
const flyout =
  'hidden absolute right-0 top-full mt-2 p-4 bg-zinc-950/95 backdrop-blur-xl rounded-lg border border-zinc-800 shadow-xl z-50 w-48';
---

<header class="flex flex-col sm:flex-row justify-between items-center card navbar-card relative">
  <a href="/" class="flex items-center">
    <img src={profile.logoUrl} alt={profile.logoAlt} class="w-12 h-12 mr-4 rounded-full" />
    <h1 class="text-4xl font-extrabold text-gray-100">{site.title}</h1>
  </a>

  <div class="flex items-center space-x-4 mt-4 sm:mt-0">
    <nav class="flex navbar-gap items-center">
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-nav-key={item.key}
            aria-current={item.key === active ? 'page' : undefined}
            class:list={[linkClass(item.key), item.overflow && 'hidden sm:flex']}
          >
            <span class="icon-label-group">
              <i class={`${item.icon} text-2xl`} />
              <span class="nav-label hidden sm:inline">{item.label}</span>
            </span>
          </a>
        ))
      }

      <div class="sm:hidden relative">
        <button id="mobile-nav-overflow-toggle" class="navbar-anim-link text-gray-400 hover:text-gray-100 transition-colors duration-200 focus:outline-none" title="More">
          <span class="icon-label-group"><i class="ri-more-2-fill text-2xl"></i></span>
        </button>
        <div id="mobile-nav-overflow-menu" class={flyout}>
          <div class="flex flex-col space-y-2">
            {
              overflowNav.map((item) => (
                <a href={item.href} data-nav-key={item.key} aria-current={item.key === active ? 'page' : undefined} class={linkClass(item.key)}>
                  <span class="icon-label-group">
                    <i class={`${item.icon} text-xl`} />
                    <span class="nav-label ml-2">{item.label}</span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <button id="search-toggle" class="navbar-anim-link text-gray-400 hover:text-gray-100 transition-colors duration-200 focus:outline-none">
        <span class="icon-label-group">
          <i class="ri-search-line text-2xl"></i><span class="nav-label hidden sm:inline">Search</span>
        </span>
      </button>
    </nav>

    <div class="text-gray-600">|</div>

    <div class="hidden sm:flex space-x-4 social-icons">
      {
        socials.map((social) => (
          <a href={social.href} title={social.title} class={`social-link ${social.variant} text-gray-400 hover:text-gray-100 transition-colors duration-200`}>
            <i class={`${social.icon} text-2xl`} />
          </a>
        ))
      }
    </div>

    <div class="sm:hidden relative">
      <button id="mobile-social-toggle" class="text-gray-400 hover:text-gray-100 transition-colors duration-200 focus:outline-none" title="Socials">
        <i class="ri-share-line text-2xl"></i>
      </button>
      <div id="mobile-social-menu" class={flyout}>
        <div class="grid grid-cols-3 gap-4 social-icons justify-items-center">
          {
            socials.map((social) => (
              <a href={social.href} title={social.title} class={`social-link ${social.variant} text-gray-400 hover:text-gray-100 transition-colors duration-200`}>
                <i class={`${social.icon} text-2xl`} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div id="search-container" class="search-hidden absolute top-full right-0 mt-2 w-full sm:w-80 px-4 sm:px-0 z-50">
    <form action="/search/" method="get" class="search-glassbar relative">
      <i class="ri-search-line absolute left-3 top-1/2 -translate-y-1/2 text-gray-300/90"></i>
      <input type="text" name="q" id="search-input" placeholder="Search posts..." autocomplete="off" required class="w-full text-gray-100 rounded-xl pl-10 pr-4 py-3 bg-transparent border-0 focus:outline-none placeholder-gray-400" />
    </form>
  </div>
</header>

<script>
  import '../scripts/ui/header';
</script>
