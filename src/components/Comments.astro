---
import { giscus } from '../config/site';
---

<div class="card static-card">
  <div id="comments-loading" class="flex justify-center py-8">
    <div class="flex flex-col items-center gap-4">
      <div class="w-12 h-12 border-4 border-gray-700 border-t-gray-100 rounded-full animate-spin"></div>
      <p class="text-gray-400">Loading comments...</p>
    </div>
  </div>

  <div id="comments-container" class="hidden">
    <div
      class="giscus-slot"
      data-repo={giscus.repo}
      data-repo-id={giscus.repoId}
      data-category={giscus.category}
      data-category-id={giscus.categoryId}
      data-theme={giscus.themeUrl}
    >
    </div>
  </div>
</div>

<script>
  import '../scripts/features/comments';
</script>
