---
/**
 * Ruler-style scroll indicator that replaces the native scrollbar on desktop.
 * Ticks are laid out along the full page height (one per percent, numbered every 5%),
 * scroll with the page, and the strip can be clicked or dragged to jump.
 */
---

<div
  id="scroll-ruler"
  transition:persist
  role="scrollbar"
  aria-controls="main"
  aria-orientation="vertical"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  aria-label="Page position"
  class="scroll-ruler"
>
  <div class="scroll-ruler__veil" aria-hidden="true"></div>
  <div class="scroll-ruler__ticks" aria-hidden="true"></div>
  <div class="scroll-ruler__marker" aria-hidden="true">
    <span class="scroll-ruler__line"></span>
    <span class="scroll-ruler__value"></span>
  </div>
  <div class="scroll-ruler__hit"></div>
</div>

<script>
  import '../scripts/ui/scroll-ruler';
</script>
