---
import { formatDate, truncate } from '../lib/text';

interface Props {
  href: string;
  title: string;
  summary?: string;
  date?: Date;
  /** Shown instead of the date, e.g. "3 posts". */
  meta?: string;
}
const { href, title, summary, date, meta } = Astro.props;
---

<a
  href={href}
  class="block card p-6 rounded-2xl bg-zinc-950/55 backdrop-blur-xl border border-white/10 shadow-lg shadow-black/30 transition-all duration-300 hover:-translate-y-1 hover:bg-zinc-900/65 hover:border-white/20 hover:shadow-2xl hover:shadow-black/40 group decoration-0"
>
  <h3 class="text-xl font-bold text-gray-100 mb-2 transition-colors">{title}</h3>
  {summary && <p class="text-gray-400 text-truncate-3">{truncate(summary, 120)}</p>}
  {(meta || date) && <div class="mt-2 text-sm text-gray-500">{meta ?? formatDate(date!)}</div>}
</a>
