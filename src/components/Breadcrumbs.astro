---
interface Props {
  trail: { label: string; href: string }[];
  current: string;
}
const { trail, current } = Astro.props;
const separator = 'ri-arrow-right-s-line text-gray-600 mx-1';
---

<nav class="flex mb-6 text-sm text-meta" aria-label="Breadcrumb">
  <ol class="inline-flex items-center space-x-1 md:space-x-2">
    <li class="inline-flex items-center">
      <a href="/" class="inline-flex items-center hover:text-gray-100 transition-colors">
        <i class="ri-home-line mr-1"></i>Home
      </a>
    </li>
    {
      trail.map((crumb) => (
        <li>
          <div class="flex items-center">
            <i class={separator} />
            <a href={crumb.href} class="hover:text-gray-100 transition-colors">{crumb.label}</a>
          </div>
        </li>
      ))
    }
    <li aria-current="page">
      <div class="flex items-center">
        <i class={separator}></i>
        <span class="text-gray-200 font-medium truncate max-w-[200px] md:max-w-none">{current}</span>
      </div>
    </li>
  </ol>
</nav>
