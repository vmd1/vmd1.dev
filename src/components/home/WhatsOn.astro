---
import { profile } from '../../config/site';
---

<section class="card h-full">
  <h2 class="text-2xl font-semibold mb-4 text-gray-100">What's up?</h2>
  <div id="whats-on-content" class="prose prose-invert text-body leading-relaxed">
    <p class="text-muted">Loading updates...</p>
  </div>

  <div class="mt-6 pt-4 border-t border-white/10 space-y-4 text-body">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-100">GitHub Activity</h3>
      <span id="activity-today" class="text-sm text-meta">Activity today: loading...</span>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wide text-meta mb-2">Last 3 commits</h4>
      <ul id="recent-commits" class="space-y-2 text-sm text-body">
        <li class="text-muted">Loading commits...</li>
      </ul>
    </div>


    <div class="pt-2">
      <a
        id="random-project-link"
        href={`https://github.com/${profile.githubUsername}?tab=repositories`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-zinc-900/50 hover:bg-zinc-800 text-gray-200 hover:text-gray-100 border border-zinc-800 hover:border-white/20 transition-all duration-300"
      >
        <i id="random-project-dice" class="ri-dice-line random-project-dice" aria-hidden="true"></i>
        <span class="font-semibold">Open a random project</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script>
  import '../../scripts/features/whats-on';
</script>
