---
import { profile } from '../../config/site';
import type { Page } from '../../lib/content';

interface Props {
  latestPost?: Page;
}
const { latestPost } = Astro.props;
const date = latestPost
  ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(latestPost.date)
  : '';
---

<section class="card h-full flex flex-col" data-rise style="--i:0">
  <h2 class="text-3xl font-bold mb-4 text-gray-100" data-rise style="--i:1">Hi!</h2>
  <p class="text-body leading-relaxed" data-rise style="--i:2">{profile.aboutIntro}</p>

  {
    latestPost && (
      <a href={latestPost.url} class="latest-post group mt-auto pt-8 block" data-rise style="--i:3">
        <span class="block rounded-2xl bg-zinc-950/55 px-5 py-4 border border-white/10 transition-all duration-300 group-hover:border-white/25 group-hover:bg-zinc-900/70 group-hover:-translate-y-0.5">
          <span class="block text-xs font-semibold uppercase tracking-[0.12em] text-meta mb-1">Latest post · {date}</span>
          <span class="flex items-center justify-between gap-4">
            <span class="font-semibold text-gray-100 leading-snug">{latestPost.title}</span>
            <span aria-hidden="true" class="text-xl text-gray-300 transition-transform duration-300 group-hover:translate-x-1.5">→</span>
          </span>
        </span>
      </a>
    )
  }
</section>
