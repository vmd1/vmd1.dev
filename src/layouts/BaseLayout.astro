---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, type NavKey } from '../config/site';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  path: string;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  socialTitle?: string;
  activeNav?: NavKey;
}

const { activeNav, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.analyticsId}`}></script>
    <script is:inline define:vars={{ id: site.analyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', id);
    </script>
    <SeoHead {...seo} />
    <link rel="preconnect" href="https://giscus.app" crossorigin />
    <link rel="preconnect" href="https://github.com" crossorigin />
    <ClientRouter />
  </head>
  <body class="text-gray-300">
    <div id="reading-progress" transition:persist class="fixed top-0 left-0 h-1 bg-linear-to-r from-zinc-200 to-zinc-500 z-[100] transition-all duration-100" style="width: 0%"></div>
    <div id="particles-js" transition:persist aria-hidden="true"></div>
    <div id="background-logo" aria-hidden="true"></div>

    <div class="container mx-auto px-4 py-8 max-w-5xl">
      <Header active={activeNav} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<script>
  import '../scripts/ui/particles';
  import '../scripts/ui/progress';
  import '../scripts/ui/tilt';
  import '../scripts/ui/lightbox';
  import '../scripts/ui/code-copy';
</script>
