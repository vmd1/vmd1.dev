---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutMe from '../components/home/AboutMe.astro';
import WhatsOn from '../components/home/WhatsOn.astro';
import RecentWork from '../components/home/RecentWork.astro';
import { site } from '../config/site';
import { getPostPages } from '../lib/content';

const posts = await getPostPages();
---

<BaseLayout title={site.title} path="/" activeNav="home">
  <div class="grid gap-8 mb-8 md:grid-cols-2 md:items-stretch">
    <AboutMe latestPost={posts[0]} />
    <WhatsOn />
  </div>
  <RecentWork posts={posts.slice(0, 4)} />
</BaseLayout>
