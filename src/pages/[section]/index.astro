---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { site } from '../../config/site';
import { getAllPages, getListedPages, sectionTitle, type Page } from '../../lib/content';

export const getStaticPaths = (async () => {
  const sections = [...new Set((await getAllPages()).map((page) => page.section))];
  const listed = await getListedPages();
  return sections.map((section) => ({
    params: { section },
    props: { section, pages: listed.filter((page) => page.section === section) },
  }));
}) satisfies GetStaticPaths;

const { section, pages } = Astro.props as { section: string; pages: Page[] };
const title = sectionTitle(section);
---

<BaseLayout title={`${title} - Init0 - ${site.title}`} socialTitle={title} path={`/${section}/`}>
  <section class="card static-card">
    <h2 class="text-2xl font-semibold mb-8 text-gray-100 text-center">#{title}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {pages.map((page) => <PostCard href={page.url} title={page.title} summary={page.summary} date={page.date} />)}
    </div>
  </section>
</BaseLayout>
