---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const filterButton = 'filter-btn px-4 py-1.5 rounded-md text-sm font-medium transition-colors';
---

<BaseLayout title={`Scripts - ${site.title}`} socialTitle="Scripts" path="/scripts/" activeNav="scripts">
  <div class="mt-8 card static-card p-8">
    <header class="mb-8 text-center">
      <h1 class="text-4xl font-bold text-gray-100">Scripts Library</h1>
    </header>

    <div class="flex flex-col md:flex-row gap-4 mb-8 justify-between items-center">
      <div class="relative w-full md:w-96">
        <i class="ri-search-line absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
        <input type="text" id="script-search" placeholder="Search scripts..." class="w-full bg-zinc-900 text-gray-100 pl-10 pr-4 py-2 rounded-lg border border-zinc-800 focus:outline-none focus:border-white/30 transition-colors" />
      </div>

      <div class="flex bg-zinc-900 rounded-lg p-1 border border-zinc-800">
        <button class={`${filterButton} bg-zinc-950 text-white`} data-os="all">All</button>
        <button class={`${filterButton} text-gray-400 hover:text-gray-200`} data-os="windows">Windows</button>
        <button class={`${filterButton} text-gray-400 hover:text-gray-200`} data-os="linux">Linux</button>
      </div>
    </div>

    <div class="mb-8 border-b border-gray-700"></div>

    <div id="scripts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pb-24">
      <div class="col-span-full text-center py-12 text-gray-500">
        <i class="ri-loader-4-line text-3xl animate-spin mb-2 inline-block"></i>
        <p>Loading scripts...</p>
      </div>
    </div>
  </div>

  <div id="batch-bar" class="fixed bottom-0 left-0 right-0 bg-zinc-950 border-t border-zinc-800 p-4 transform translate-y-full transition-transform duration-300 z-50 shadow-2xl">
    <div class="container mx-auto max-w-5xl flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="bg-zinc-950 text-white px-3 py-1 rounded-full text-sm font-bold" id="batch-count">0</div>
        <span class="text-gray-300 font-medium">Scripts Selected</span>
        <button id="batch-clear" class="text-sm text-gray-400 hover:text-red-400 transition-colors">Clear All</button>
      </div>

      <div class="flex-1 w-full md:w-auto flex items-center gap-2">
        <div class="relative flex-1">
          <input type="text" id="batch-command" readonly class="w-full bg-zinc-900 text-gray-300 px-4 py-2 rounded-lg border border-zinc-800 font-mono text-sm focus:outline-none" />
        </div>
        <button id="batch-copy" class="bg-zinc-950 hover:bg-zinc-800 text-white px-4 py-2 rounded-lg transition-colors flex items-center gap-2 font-medium">
          <i class="ri-file-copy-line"></i>
          <span>Copy Command</span>
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/features/scripts-library';
</script>
